# Copy to .env.production and provide values through your release secret manager.
# Never commit the populated file.

APP_IMAGE=artix-api:latest
ASPNETCORE_ENVIRONMENT=Production
HTTP_PORT=8080

# Published infrastructure ports (only needed when exposing services from the host)
REDIS_HOST_PORT=6379
MSSQL_HOST_PORT=1433
MONGO_HOST_PORT=27017
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# Infrastructure credentials
MSSQL_SA_PASSWORD=__SET_PROD_SQL_PASSWORD__
MSSQL_PID=Express
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=__SET_PROD_MONGO_PASSWORD__
REDIS_PASSWORD=__SET_PROD_REDIS_PASSWORD__
RABBITMQ_DEFAULT_USER=__SET_PROD_RABBITMQ_USERNAME__
RABBITMQ_DEFAULT_PASS=__SET_PROD_RABBITMQ_PASSWORD__

AuthenticationApi__ApiKey=__SET_PROD_API_KEY__
AuthenticationApi__RequireApiKeyInProduction=true

ConnectionStrings__CommandConnectionString=Server=sqlserver;Database=ArtixDb;User Id=sa;Password=__SET_PROD_SQL_PASSWORD__;TrustServerCertificate=True;Pooling=true;Max Pool Size=100;Min Pool Size=5;Connect Timeout=30;Encrypt=True;
ConnectionStrings__QueryConnectionString=Server=sqlserver;Database=ArtixDb;User Id=sa;Password=__SET_PROD_SQL_PASSWORD__;TrustServerCertificate=True;Pooling=true;Max Pool Size=200;Min Pool Size=10;MultipleActiveResultSets=true;Connect Timeout=60;Encrypt=True;

RabbitMqOptions__Host=rabbitmq
RabbitMqOptions__Port=5672
RabbitMqOptions__Username=__SET_PROD_RABBITMQ_USERNAME__
RabbitMqOptions__Password=__SET_PROD_RABBITMQ_PASSWORD__

RedisOptions__Host=redis
RedisOptions__Port=6379
RedisOptions__Password=__SET_PROD_REDIS_PASSWORD__

MongoDbSettings__ConnectionString=mongodb://admin:__SET_PROD_MONGO_PASSWORD__@mongodb:27017/admin?authSource=admin&authMechanism=SCRAM-SHA-256

Elasticsearch__Uri=https://elasticsearch.drlink.ir
Elasticsearch__Username=__SET_PROD_ELASTICSEARCH_USERNAME__
Elasticsearch__Password=__SET_PROD_ELASTICSEARCH_PASSWORD__

FileSettings__BaseUrl=https://nazari.drl.ink/files
FileSettings__StoragePath=/app/files
FileSettings__TempPath=/app/files/tmp
FileSettings__FFmpegPath=ffmpeg
DataProtection__KeyPath=/app/dataprotection-keys

AllowedOrigins__0=https://nazari-ui.drl.ink
AllowedOrigins__1=https://nazari-pwd.drl.ink