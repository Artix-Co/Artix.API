{
  "AuthenticationApi": {
    "ApiKey": "${ARTIX_DEV_API_KEY}",
    "RequireApiKeyInProduction": false
  },
  "EnableSwagger": true,
  "ConnectionStrings": {
    "CommandConnectionString": "Server=localhost,1434;Database=ArtixDb;User Id=sa;Password=${ARTIX_DEV_SQL_PASSWORD};TrustServerCertificate=True;Pooling=true;Max Pool Size=100;Min Pool Size=5;Connect Timeout=15;Encrypt=True;",
    "QueryConnectionString": "Server=localhost,1434;Database=ArtixDb;User Id=sa;Password=${ARTIX_DEV_SQL_PASSWORD};TrustServerCertificate=True;Pooling=true;Max Pool Size=200;Min Pool Size=10;MultipleActiveResultSets=true;Connect Timeout=30;Encrypt=True;"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "Username": "${ARTIX_DEV_ELASTICSEARCH_USERNAME}",
    "Password": "${ARTIX_DEV_ELASTICSEARCH_PASSWORD}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "AllowedOrigins": [
    "https://localhost:7260",
    "https://localhost:62950",
    "https://localhost:7091",
    "https://localhost:7097",
    "http://localhost:3000",
    "https://localhost:7092"
  ],
  "FileSettings": {
    "BaseUrl": "https://localhost:7013/files",
    "StoragePath": "uploads/files",
    "TempPath": "tmp"
  },
  "RabbitMqOptions": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "${ARTIX_DEV_RABBITMQ_USERNAME}",
    "Password": "${ARTIX_DEV_RABBITMQ_PASSWORD}"
  },
  "RedisOptions": {
    "Host": "localhost",
    "Port": 6379,
    "Password": "${ARTIX_DEV_REDIS_PASSWORD}"
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://admin:${ARTIX_DEV_MONGO_PASSWORD}@127.0.0.1:27017/admin?authSource=admin&authMechanism=SCRAM-SHA-256"
  },
  "DataProtection": {
    "KeyPath": "dataprotection-keys"
  }
}
