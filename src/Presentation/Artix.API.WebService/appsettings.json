  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Warning",
      "Default": "Information"
    }
  },
  "MongoDbSettings": {
    "DatabaseName": "ArtixDb"
  },
  "AllowedOrigins": [],
  "RabbitMqOptions": {
    "Username": "admin",
    "Port": 5672,
    "Password": "admin"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Elasticsearch"
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "MinimumLevel": {
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    }
  },
  "Authentication": {
    "Audience": "ArtixClients",
    "RefreshTokenLength": 64,
    "TokenProvider": "ArtixApp",
    "AccessTokenExpireSeconds": 3600,
    "RefreshTokenExpireDays": 7,
    "Issuer": "ArtixAPI"
  },
  "FileSettings": {
    "AllowGzipForOtherFiles": true,
    "Allowed3DMimeTypes": [
      ".glb",
      ".gltf",
      ".json"
    ],
    "FFmpegPath": "ffmpeg",
    "AllowedImageMimeTypes": [
      ".jpeg",
      ".png",
      ".jpg"
    ],
    "ScanIntervalSeconds": 20,
    "AllowedReadmeMimeTypes": [
      ".md",
      ".txt",
      ".pdf",
      ".html",
      ".docx"
    ],
    "ExtensionsToSkip": [
      ".gz",
      ".zip",
      ".rar",
      ".7z",
      ".br"
    ]
  },
  "RedisOptions": {
    "Password": "Heli@ghar771379",
    "Port": 6379
  },
  "Elasticsearch": {
    "IndexFormat": "artix-logs-{0:yyyy.MM.dd}",
    "Username": "elastic",
