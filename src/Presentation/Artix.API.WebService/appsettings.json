    "Audience": "Artix-Audience-Dev",
    "IssuerSigningKey": "P@ssw0rd_Artix_SuperSecureKey_ChangeThisInProduction_2025!",
    "AccessTokenExpireSeconds": 900,
    "RefreshTokenExpireDays": 30,
    "RefreshTokenLength": 64,
    "TokenProvider": "ArtixApp"
  },
  "FileSettings": {
    "BaseUrl": "https://nazari.drl.ink/files",
    "StoragePath": "/app/files",
    "TempPath": "/app/files/tmp",

    "Allowed3DMimeTypes": [
