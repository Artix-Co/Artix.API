{
  "AuthenticationApi": {
    "ApiKey": "YourFixedApiKey12345",
    "RequireApiKeyInProduction": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CommandConnectionString": "Server=sqlserver;Database=ArtixDb;User Id=sa;Password=Hello&Run1234;TrustServerCertificate=True;Pooling=true;Max Pool Size=100;Min Pool Size=5;Connect Timeout=30;Encrypt=True;",
    "QueryConnectionString": "Server=sqlserver;Database=ArtixDb;User Id=sa;Password=Hello&Run1234;TrustServerCertificate=True;Pooling=true;Max Pool Size=200;Min Pool Size=10;MultipleActiveResultSets=true;Connect Timeout=60;"
