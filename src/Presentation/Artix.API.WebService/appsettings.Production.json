{
  "AuthenticationApi": {
    "ApiKey": "${ARTIX_PROD_API_KEY}",
    "RequireApiKeyInProduction": true
  },
  "ConnectionStrings": {
    "CommandConnectionString": "Server=sqlserver;Database=ArtixDb;User Id=sa;Password=${ARTIX_PROD_SQL_PASSWORD};TrustServerCertificate=True;Pooling=true;Max Pool Size=100;Min Pool Size=5;Connect Timeout=30;Encrypt=True;",
    "QueryConnectionString": "Server=sqlserver;Database=ArtixDb;User Id=sa;Password=${ARTIX_PROD_SQL_PASSWORD};TrustServerCertificate=True;Pooling=true;Max Pool Size=200;Min Pool Size=10;MultipleActiveResultSets=true;Connect Timeout=60;"
  },
  "Elasticsearch": {
    "Uri": "https://elasticsearch.drlink.ir",
    "Username": "${ARTIX_PROD_ELASTICSEARCH_USERNAME}",
    "Password": "${ARTIX_PROD_ELASTICSEARCH_PASSWORD}"
  },
  "AllowedOrigins": [
    "https://nazari-ui.drl.ink",
    "https://nazari-pwd.drl.ink"
  ],
  "FileSettings": {
    "BaseUrl": "https://nazari.drl.ink/files",
    "StoragePath": "/app/files",
    "TempPath": "/app/files/tmp"
  },
  "RabbitMqOptions": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "${ARTIX_PROD_RABBITMQ_USERNAME}",
    "Password": "${ARTIX_PROD_RABBITMQ_PASSWORD}"
  },
  "RedisOptions": {
    "Host": "redis",
    "Port": 6379,
    "Password": "${ARTIX_PROD_REDIS_PASSWORD}"
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://admin:${ARTIX_PROD_MONGO_PASSWORD}@mongodb:27017/admin?authSource=admin&authMechanism=SCRAM-SHA-256"
  },
  "DataProtection": {
    "KeyPath": "/app/dataprotection-keys"
  }
}
