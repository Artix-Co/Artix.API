# Copy to .env and customize. Never commit .env.

APP_IMAGE=artix-api:local
HTTP_PORT=8080

# Container memory guards (prevent host memory pressure)
APP_MEM_LIMIT=1g
APP_MEM_RESERVATION=512m
MSSQL_MEM_LIMIT=2g
MSSQL_MEM_RESERVATION=1g
MONGO_MEM_LIMIT=1g
MONGO_MEM_RESERVATION=512m
RABBITMQ_MEM_LIMIT=512m
RABBITMQ_MEM_RESERVATION=256m
REDIS_MEM_LIMIT=256m
REDIS_MEM_RESERVATION=128m
NGINX_MEM_LIMIT=128m
NGINX_MEM_RESERVATION=64m

# Host ports (change if busy on your machine)
REDIS_HOST_PORT=6380
MSSQL_HOST_PORT=1434
MONGO_HOST_PORT=27017
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

MSSQL_SA_PASSWORD=Artix_Sql_Str0ng1!
MSSQL_PID=Express

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=Artix_Mongo_Str0ng1!

REDIS_PASSWORD=Artix_Redis_Str0ng1!

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=Artix_Rabbit_Str0ng1!

ASPNETCORE_ENVIRONMENT=Production
EnableSwagger=true

ConnectionStrings__CommandConnectionString=Server=sqlserver;Database=ArtixDb;User Id=sa;Password=Artix_Sql_Str0ng1!;TrustServerCertificate=True;Pooling=true;Max Pool Size=100;Min Pool Size=5;Connect Timeout=30;Encrypt=True;
ConnectionStrings__QueryConnectionString=Server=sqlserver;Database=ArtixDb;User Id=sa;Password=Artix_Sql_Str0ng1!;TrustServerCertificate=True;Pooling=true;Max Pool Size=200;Min Pool Size=10;MultipleActiveResultSets=true;Connect Timeout=60;Encrypt=True;

Authentication__Issuer=Artix-Issuer
Authentication__Audience=Artix-Audience
Authentication__IssuerSigningKey=Artix_Jwt_SigningKey_LocalDev_32Chars!
Authentication__AccessTokenExpireSeconds=900
Authentication__RefreshTokenExpireDays=30
Authentication__RefreshTokenLength=64
Authentication__TokenProvider=ArtixApp

AuthenticationApi__ApiKey=Artix_Local_ApiKey
AuthenticationApi__RequireApiKeyInProduction=false

RabbitMqOptions__Host=rabbitmq
RabbitMqOptions__Port=5672
RabbitMqOptions__Username=admin
RabbitMqOptions__Password=Artix_Rabbit_Str0ng1!

# Inside Docker network Redis still listens on 6379
RedisOptions__Host=redis
RedisOptions__Port=6379
RedisOptions__Password=Artix_Redis_Str0ng1!

MongoDbSettings__ConnectionString=mongodb://admin:Artix_Mongo_Str0ng1%21@mongodb:27017/admin?authSource=admin&authMechanism=SCRAM-SHA-256
MongoDbSettings__DatabaseName=ArtixDb

Elasticsearch__Uri=
Elasticsearch__Username=
Elasticsearch__Password=
Elasticsearch__IndexFormat=artix-logs-{0:yyyy.MM.dd}
Elasticsearch__RequestTimeoutInMinutes=2

FileSettings__BaseUrl=http://localhost:8080/files
FileSettings__StoragePath=/app/files
FileSettings__TempPath=/app/files/tmp
FileSettings__FFmpegPath=ffmpeg
DataProtection__KeyPath=/app/dataprotection-keys

AllowedOrigins__0=http://localhost:3000
AllowedOrigins__1=https://localhost:3000
AllowedOrigins__2=https://nazari-ui.drl.ink
AllowedOrigins__3=https://nazari-pwd.drl.ink
