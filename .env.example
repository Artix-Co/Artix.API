# Copy to .env and customize for the Development Docker environment. Never commit .env.

APP_IMAGE=artix-api:local
ASPNETCORE_ENVIRONMENT=Development
HTTP_PORT=8080
EnableSwagger=true

# Host ports (change if busy on your machine)
REDIS_HOST_PORT=6380
MSSQL_HOST_PORT=1434
MONGO_HOST_PORT=27017
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# Local container credentials. Replace these values in your private .env.
MSSQL_SA_PASSWORD=__SET_DEV_SQL_PASSWORD__
MSSQL_PID=Express
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=__SET_DEV_MONGO_PASSWORD__
REDIS_PASSWORD=__SET_DEV_REDIS_PASSWORD__
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=__SET_DEV_RABBITMQ_PASSWORD__

AuthenticationApi__ApiKey=__SET_DEV_API_KEY__
AuthenticationApi__RequireApiKeyInProduction=false

ConnectionStrings__CommandConnectionString=Server=sqlserver;Database=ArtixDb;User Id=sa;Password=__SET_DEV_SQL_PASSWORD__;TrustServerCertificate=True;Pooling=true;Max Pool Size=100;Min Pool Size=5;Connect Timeout=30;Encrypt=True;
ConnectionStrings__QueryConnectionString=Server=sqlserver;Database=ArtixDb;User Id=sa;Password=__SET_DEV_SQL_PASSWORD__;TrustServerCertificate=True;Pooling=true;Max Pool Size=200;Min Pool Size=10;MultipleActiveResultSets=true;Connect Timeout=60;Encrypt=True;

RabbitMqOptions__Host=rabbitmq
RabbitMqOptions__Port=5672
RabbitMqOptions__Username=admin
RabbitMqOptions__Password=__SET_DEV_RABBITMQ_PASSWORD__

RedisOptions__Host=redis
RedisOptions__Port=6379
RedisOptions__Password=__SET_DEV_REDIS_PASSWORD__

MongoDbSettings__ConnectionString=mongodb://admin:__SET_DEV_MONGO_PASSWORD__@mongodb:27017/admin?authSource=admin&authMechanism=SCRAM-SHA-256

# Elasticsearch is optional; leave URI empty to disable it.
Elasticsearch__Uri=
Elasticsearch__Username=
Elasticsearch__Password=

FileSettings__BaseUrl=http://localhost:8080/files
FileSettings__StoragePath=/app/files
FileSettings__TempPath=/app/files/tmp
FileSettings__FFmpegPath=ffmpeg
DataProtection__KeyPath=/app/dataprotection-keys

AllowedOrigins__0=http://localhost:3000
AllowedOrigins__1=https://localhost:3000
AllowedOrigins__2=https://localhost:7260
AllowedOrigins__3=https://localhost:62950
AllowedOrigins__4=https://localhost:7091
AllowedOrigins__5=https://localhost:7097
AllowedOrigins__6=https://localhost:7092